# Copy to demo.env (same folder). Nothing secret belongs here.
# The public https origin of the demo, exactly as people will type it (no trailing slash).
SSS_ORIGIN=https://demo.example.com
# Free quick-tunnel path only (docs/HOSTED_DEMO.md, "Free path"): uncomment this line. SSS_ORIGIN above is then
# overwritten automatically with the tunnel's current address, so leave it as a placeholder.
# SSS_MODE=quicktunnel
