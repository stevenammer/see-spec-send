[Unit]
Description=See Spec Send scheduled backups (verified, pruned)
After=see-spec-send-server.service

[Service]
Type=simple
WorkingDirectory=/opt/see-spec-send
Environment=SSS_DB=/var/lib/see-spec-send/sss.db
# Writes a verified backup every hour and keeps the newest 72. Add --key-file to encrypt. Put the backup folder on a different disk.
ExecStart=/usr/bin/node /opt/see-spec-send/cli.js replicate --to /var/backups/see-spec-send --every 1h --keep 72
Restart=on-failure
User=see-spec-send
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/var/backups/see-spec-send

[Install]
WantedBy=multi-user.target
