{
  "name": "seespecsend",
  "version": "0.0.1",
  "private": true,
  "description": "See it. Spec it. Send it. A way for any organization to turn the problems everyone already knows about into small, checked, capped experiments that the people doing the work confirm help.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "preview": "node scripts/preview.mjs",
    "test:demo-vision": "node test/e2e/demo-vision.e2e.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:listen": "node --test test/listener.smoke.mjs",
    "test:e2e": "node test/e2e/manual-path.e2e.mjs",
    "test:decision-outcomes": "node test/e2e/decision-outcomes.e2e.mjs",
    "test:stage-freeze": "node test/e2e/stage-freeze.e2e.mjs",
    "test:vision": "node test/e2e/vision-journey.e2e.mjs",
    "test:reanalysis": "node test/e2e/reanalysis-journey.e2e.mjs",
    "test:idp-interop": "node test/e2e/idp-interop.e2e.mjs",
    "test:a11y": "node scripts/a11y-audit.mjs",
    "drill": "sh scripts/drill.sh",
    "test:failover": "node scripts/failover-drill.mjs",
    "load": "node scripts/load.mjs",
    "test:hostile-render": "node test/e2e/hostile-render.e2e.mjs",
    "test:artifact-origin": "node test/e2e/artifact-origin.e2e.mjs",
    "test:bundle-origin": "node test/e2e/bundle-origin.e2e.mjs",
    "test:container": "node --test test/container.acceptance.mjs",
    "sync:demo": "node scripts/sync-demo.mjs",
    "check:demo": "node scripts/sync-demo.mjs --check",
    "check:public": "node scripts/check-public.mjs",
    "check:mutants": "node scripts/mutate-check.mjs",
    "check:mutants-new": "node scripts/mutate-new.mjs"
  }
}
