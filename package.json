{
  "name": "seespecsend",
  "version": "0.0.1",
  "private": true,
  "description": "See it. Spec it. Send it. A way for any organization to turn the problems everyone already knows about into small, checked, capped experiments that the people doing the work confirm help.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:listen": "node --test test/listener.smoke.mjs",
    "test:e2e": "node test/e2e/manual-path.e2e.mjs",
    "test:artifact-origin": "node test/e2e/artifact-origin.e2e.mjs",
    "sync:demo": "node scripts/sync-demo.mjs",
    "check:demo": "node scripts/sync-demo.mjs --check",
    "check:public": "node scripts/check-public.mjs",
    "check:mutants": "node scripts/mutate-check.mjs"
  }
}
